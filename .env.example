# PENTING: JANGAN pernah commit file .env yang berisi kredensial asli!
# Untuk Vercel, isi kedua variabel ini di dashboard:
#   Project → Settings → Environment Variables → lalu Deploy ulang.
# (Vercel TIDAK membaca file .env dari repo.)
#
# Dapatkan nilainya dari Upstash Console → database Anda → bagian "REST API":
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
